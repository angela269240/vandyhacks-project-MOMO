# Oracle features (Autonomous Database, OCI Speech, Generative AI, Object Storage) are disconnected in code
# (lib/db.ts, lib/oci.ts), so the ORACLE_* and OCI_* values below are ignored.
#
# Copy to .env.local. Everything is optional: with nothing set, the app runs on an
# in-memory demo world with SSE realtime and local-only voice/screen preview.

# --- OCI Autonomous Database (Oracle 23ai), TLS without wallet ---
ORACLE_USER=
ORACLE_PASSWORD=
# The "_low" service TLS connect descriptor from the DB console (Database connection → TLS)
ORACLE_CONNECT_STRING=

# --- OCI API key (Object Storage now; Generative AI later) ---
OCI_TENANCY_OCID=
OCI_USER_OCID=
OCI_FINGERPRINT=
# PEM private key with newlines escaped as \n
OCI_PRIVATE_KEY=
OCI_PRIVATE_KEY_PASSPHRASE=
OCI_REGION=us-ashburn-1
OCI_COMPARTMENT_OCID=

# --- OCI Object Storage (avatars/, chat-archive/) ---
OCI_OS_NAMESPACE=
OCI_OS_BUCKET=social-mapper
# Public-read (no listing) bucket for avatars/ only, so chat-archive/ in OCI_OS_BUCKET stays private.
# Empty = avatars go in OCI_OS_BUCKET.
OCI_OS_AVATAR_BUCKET=social-mapper-avatars
# Optional bucket-level read PAR (ends in /o/). Not needed when the avatar bucket is public.
OCI_OS_READ_PAR_URL=

# --- OCI Generative AI (not used by the app yet) ---
OCI_GENAI_MODEL_ID=

# --- LiveKit Cloud (voice, screen share, realtime events) ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Email (codes for .edu sign-up and admin sign-in) ---
# Any SMTP server: OCI Email Delivery (smtp.email.us-chicago-1.oci.oraclecloud.com), Gmail with an app password, Resend...
# Unset = codes are printed to the server log instead of emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Sender address; must be an approved sender on OCI Email Delivery. Defaults to SMTP_USER.
EMAIL_FROM=

# --- Admin dashboard (/admin) ---
# Comma-separated admin emails; each sign-in emails them a code. Default: eluo.5230@gmail.com
ADMIN_EMAILS=
# Signs the admin session cookie and the verified-email token. Set it on Vercel (any long random string);
# falls back to CRON_SECRET, then to a per-process random value (fine for local dev).
AUTH_SECRET=

# --- Misc ---
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=
# 1 = empty groups and "away" users linger 2 minutes instead of 30 days (demo expiry live)
FAST_CLOCK=
# 0 = don't auto-send two welcome friend requests from seeded users to new profiles
DEMO_WELCOME_REQUESTS=
