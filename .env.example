# Copy to .env.local. Everything is optional: with nothing set, the app runs on an
# in-memory demo world with SSE realtime and local-only voice/screen preview.

# --- OCI Autonomous Database (Oracle 23ai), TLS without wallet ---
ORACLE_USER=
ORACLE_PASSWORD=
# The "_low" service TLS connect descriptor from the DB console (Database connection → TLS)
ORACLE_CONNECT_STRING=

# --- OCI API key (Object Storage now; Generative AI later) ---
OCI_TENANCY_OCID=
OCI_USER_OCID=
OCI_FINGERPRINT=
# PEM private key with newlines escaped as \n
OCI_PRIVATE_KEY=
OCI_PRIVATE_KEY_PASSPHRASE=
OCI_REGION=us-ashburn-1
OCI_COMPARTMENT_OCID=

# --- OCI Object Storage (avatars/, chat-archive/) ---
OCI_OS_NAMESPACE=
OCI_OS_BUCKET=social-mapper
# Public-read (no listing) bucket for avatars/ only, so chat-archive/ in OCI_OS_BUCKET stays private.
# Empty = avatars go in OCI_OS_BUCKET.
OCI_OS_AVATAR_BUCKET=social-mapper-avatars
# Optional bucket-level read PAR (ends in /o/). Not needed when the avatar bucket is public.
OCI_OS_READ_PAR_URL=

# --- OCI Generative AI (not used by the app yet) ---
OCI_GENAI_MODEL_ID=

# --- LiveKit Cloud (voice, screen share, realtime events) ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Misc ---
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=
# 1 = groups and "away" users linger 2 minutes instead of 24 hours (demo expiry live)
FAST_CLOCK=
# 0 = don't auto-send two welcome friend requests from seeded users to new profiles
DEMO_WELCOME_REQUESTS=
